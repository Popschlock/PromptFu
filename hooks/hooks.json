{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-gate.js"],
            "timeout": 10,
            "statusMessage": "PromptFu dispatch gate"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/long-prompt-check.js"],
            "timeout": 15,
            "statusMessage": "PromptFu length check"
          }
        ]
      }
    ]
  }
}
